ALPACA_API_KEY_ID=your_key_id
ALPACA_API_SECRET_KEY=your_secret_key

# Market Data API is used for historical bars.
ALPACA_DATA_API_BASE_URL=https://data.alpaca.markets/v2

# Paper Trading API is recorded for account/trading extensions.
ALPACA_TRADING_API_BASE_URL=https://paper-api.alpaca.markets/v2

# Historical stock bars feed for regular, premarket, and aftermarket data.
# Use sip when available; iex can be sparse outside regular hours.
ALPACA_STOCK_FEED=sip

# Historical overnight feed. Alpaca historical stock bars currently list boats.
ALPACA_OVERNIGHT_FEED=boats

# Local proxy port.
PORT=3001

# Local SQLite cache path.
SQLITE_DB_PATH=data/market-data.sqlite
